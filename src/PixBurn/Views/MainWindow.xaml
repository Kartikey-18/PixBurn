<Window x:Class="PixBurn.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PixBurn.Views"
        Title="PixBurn - DICOM Annotation Tool"
        Icon="pack://application:,,,/Resources/Icons/app.ico"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <DockPanel>
        <!-- TOOLBAR -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="12,8">
            <DockPanel>
                <!-- Right: Save buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Overwrite original DICOM with annotations"
                            Margin="0,0,8,0" />
                    <Button Content="Save as New"
                            Command="{Binding SaveAsNewCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Save to PixBurned folder" />
                </StackPanel>

                <!-- Left: File operations -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Import Files"
                            Command="{Binding FileList.BrowseFilesCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Clear All"
                            Command="{Binding FileList.ClearFilesCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Progress.CurrentFileName}"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Visibility="{Binding Progress.IsSaving, Converter={StaticResource BoolToVis}}"
                           Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusBarText}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: File list -->
            <views:FileListView Grid.Column="0" DataContext="{Binding FileList}" />

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- Right: Annotation editor -->
            <views:AnnotationEditorView Grid.Column="2" DataContext="{Binding Editor}" />
        </Grid>
    </DockPanel>
</Window>
