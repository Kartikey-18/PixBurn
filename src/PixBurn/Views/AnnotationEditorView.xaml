<UserControl x:Class="PixBurn.Views.AnnotationEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PixBurn.Controls"
             xmlns:models="clr-namespace:PixBurn.Models"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tool Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8">
            <WrapPanel Orientation="Horizontal">
                <!-- Tool Selection -->
                <RadioButton Content="Select" GroupName="Tools"
                             IsChecked="{Binding SelectedTool, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:AnnotationToolType.Select}}"
                             Style="{StaticResource ToolButton}" />
                <RadioButton Content="Arrow" GroupName="Tools"
                             IsChecked="{Binding SelectedTool, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:AnnotationToolType.Arrow}}"
                             Style="{StaticResource ToolButton}" />
                <RadioButton Content="Rectangle" GroupName="Tools"
                             IsChecked="{Binding SelectedTool, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:AnnotationToolType.Rectangle}}"
                             Style="{StaticResource ToolButton}" />
                <RadioButton Content="Text" GroupName="Tools"
                             IsChecked="{Binding SelectedTool, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:AnnotationToolType.Text}}"
                             Style="{StaticResource ToolButton}" />

                <Separator Margin="12,0" />

                <!-- Color Picker -->
                <TextBlock Text="Color:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="90"
                          ItemsSource="{Binding ColorOptions}"
                          SelectedItem="{Binding CurrentStrokeColor}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="16" Height="16" Margin="0,0,6,0">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Separator Margin="12,0" />

                <!-- Font Size -->
                <TextBlock Text="Text Size:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="60" SelectedItem="{Binding CurrentFontSize}" VerticalAlignment="Center">
                    <ComboBox.Items>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">36</sys:Double>
                        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib">48</sys:Double>
                    </ComboBox.Items>
                </ComboBox>

                <Separator Margin="12,0" />

                <!-- Zoom Controls -->
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="-" Width="28" Command="{Binding ZoomOutCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" />
                <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center"
                           Width="45" TextAlignment="Center" />
                <Button Content="+" Width="28" Command="{Binding ZoomInCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" />
                <Button Content="Fit" Width="35" Command="{Binding ZoomFitCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />

                <Separator Margin="12,0" />

                <!-- Delete / Clear -->
                <Button Content="Delete"
                        Command="{Binding DeleteAnnotationCommand}"
                        CommandParameter="{Binding SelectedAnnotation}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Clear All"
                        Command="{Binding ClearAnnotationsCommand}"
                        Style="{StaticResource DangerButton}" />
            </WrapPanel>
        </Border>

        <!-- Canvas Area -->
        <Border Grid.Row="1" Background="#1a1a1a" ClipToBounds="True">
            <Grid>
                <!-- Empty state -->
                <TextBlock Text="Select a DICOM file to annotate"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentFile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Scrollable Image Container -->
                <ScrollViewer x:Name="ImageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentFile, Converter={StaticResource BoolToVis}}"
                              Background="Transparent">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                        </Grid.LayoutTransform>

                        <Image x:Name="DicomImage"
                               Source="{Binding DisplayImage}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="None" />

                        <controls:AnnotationCanvas x:Name="AnnotationCanvas"
                            Width="{Binding DisplayImage.PixelWidth}"
                            Height="{Binding DisplayImage.PixelHeight}"
                            Annotations="{Binding Annotations}"
                            SelectedAnnotation="{Binding SelectedAnnotation, Mode=TwoWay}"
                            SelectedTool="{Binding SelectedTool}"
                            CurrentStrokeColor="{Binding CurrentStrokeColor}"
                            CurrentStrokeWidth="{Binding CurrentStrokeWidth}"
                            Background="Transparent" />

                        <!-- Text Editing Overlay -->
                        <Canvas x:Name="TextEditCanvas"
                                Width="{Binding DisplayImage.PixelWidth}"
                                Height="{Binding DisplayImage.PixelHeight}"
                                Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVis}}">
                            <TextBox x:Name="TextEditBox"
                                     Text="{Binding EditingTextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{Binding EditingTextFontSize}"
                                     Foreground="{Binding EditingTextBrush}"
                                     Background="#CC000000"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource PrimaryBrush}"
                                     Padding="4,2"
                                     MinWidth="50"
                                     AcceptsReturn="True"
                                     Canvas.Left="{Binding EditingTextLeft}"
                                     Canvas.Top="{Binding EditingTextTop}"
                                     KeyDown="TextEditBox_KeyDown"
                                     LostFocus="TextEditBox_LostFocus" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
